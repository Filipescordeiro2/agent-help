# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env preenchido (ver Constitution §Gestão de Credenciais).

# --- MongoDB Atlas (local: mongodb/mongodb-atlas-local via docker-compose; produção: cluster Atlas real) ---
MONGODB_URI=mongodb://localhost:27017/getnet_support

# --- OpenRouter (camada única de abstração de LLM — nunca hardcoded) ---
# A chave do OpenRouter NAO fica aqui: envie-a a cada requisição no cabeçalho X-API-Key-LLM
# (Swagger: Authorize; Postman: variável llm_api_key). Trocar de chave não exige reiniciar.
# OPENROUTER_API_KEY=   # opcional, só como fallback sem requisição (ex.: rotina agendada); deixe vazio
OPENROUTER_MODEL=openai/gpt-5-nano
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelos de raciocínio (ex.: openai/gpt-5-nano) não aceitam `temperature`; ajuste o esforço de
# raciocínio (minimal | low | medium | high; vazio = não enviar) e o timeout por chamada.
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_SECONDS=60
# Teto de tokens de saída por chamada (inclui raciocínio). Evita erro 402 em contas com saldo baixo.
OPENROUTER_MAX_TOKENS=4096

# --- Embeddings (dimensão nunca fixa no código) ---
# O modelo de chat NÃO gera embeddings: use um modelo de embeddings do OpenRouter
# (ex.: openai/text-embedding-3-small -> 1536 dimensões). Se mudar a dimensão com o banco já
# populado, recrie os índices vetoriais e reindexe (docker compose down -v apaga os dados locais).
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Observabilidade ---
LOG_LEVEL=INFO

# --- Fronteira de confiança da API (FR-046) — apenas canais internos autenticados podem chamar /api/v1/* ---
INTERNAL_SERVICE_TOKEN=local-dev-token-change-me

# --- Provedor de LLM: `openrouter` (real, exige a chave em X-API-Key-LLM) ou `fake` (offline) ---
LLM_PROVIDER=openrouter

# --- Definicoes do agente (Skills, Playbooks, Keywords) ---
# Arquivos YAML em src/app/agent/definitions/ sao gravados no MongoDB (com embeddings) no boot.
# Sem chave do LLM no boot, os embeddings sao gerados na 1a requisicao que trouxer X-API-Key-LLM.
AGENT_DEFINITIONS_ENABLED=true
# Pasta alternativa (ex.: volume montado) para editar sem recompilar; vazio = as empacotadas.
AGENT_DEFINITIONS_DIR=

# --- Acesso a paginas web como base de conhecimento (RAG) ---
# Se a base nao responde, o agente le a pagina (URL da mensagem ou fontes web cadastradas) e SALVA
# na base vetorial so os trechos relevantes ao tema. Sempre com protecao contra SSRF (so hosts publicos, portas 80/443).
WEB_ACCESS_ENABLED=true
# Restringe os dominios consultaveis (lista separada por virgula; casa o dominio e subdominios).
# Vazio = qualquer host publico. Recomendado em producao, p.ex.: getnet.com.br,docs.exemplo.com
WEB_ALLOWED_DOMAINS=
# As fontes que o AGENTE consulta sozinho (getnet.net, docs.globalgetnet.com, site.getnet.com.br)
# vem de src/app/agent/definitions/web_sources/ e sao gerenciadas pela API /api/v1/web-sources.
# Quantas fontes consultar por pergunta (a mais relevante primeiro se houver mais que isso):
WEB_MAX_SOURCES_PER_QUESTION=5
# Se a pagina inicial nao tem nada relevante, segue links do MESMO site que combinem com a pergunta:
WEB_FOLLOW_LINKS=true
WEB_MAX_LINKED_PAGES=2
# Texto devolvido ao cliente quando nem a base nem as fontes web tem a informacao (opcional):
# SUPPORT_CONTACT_MESSAGE=Nao encontrei ... entre em contato com a central de atendimento (0800 ...).
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_MAX_BYTES=2000000
WEB_MAX_CHARS=60000
WEB_MAX_URLS_PER_MESSAGE=2
# Similaridade minima (0-1) para um trecho da pagina ser considerado relevante e salvo. Medido com
# text-embedding-3-small: relevantes 0.67-0.81, irrelevantes do mesmo site ate ~0.54. Ajuste ao trocar de modelo.
WEB_MIN_SCORE=0.60
# Similaridade minima da base de conhecimento para considerar que ela "responde" (igual ao da web).
# KNOWLEDGE_MIN_SCORE=0.60

# Mensagem de boas-vindas (saudacao / "o que voce faz?"). Vazio = a mensagem padrao, que lista os
# assuntos atendidos e da exemplos de perguntas.
# WELCOME_MESSAGE=

# Suporte guiado (caso + chamado): perguntas de esclarecimento antes de desistir, tentativas de
# solucao antes de abrir o chamado e mensagens da conversa que vao no chamado.
SUPPORT_MAX_CLARIFICATIONS=2
SUPPORT_MAX_SOLUTION_ATTEMPTS=2
SUPPORT_TICKET_CONVERSATION_MAX_MESSAGES=30

# Limite de requisicoes por usuario (X-User-Id) ou IP; o Collection Runner do Postman (85 requests)
# pode passar do padrao de 60 por minuto.
# RATE_LIMIT_MAX_REQUESTS=60

# --- Grounding (Constitution Principio X) — limiar inteiro entre 0 e 5; so score < limiar bloqueia ---
GROUNDING_MIN_SCORE=3
# Feedback automatico: nota de grounding de 0 ate este valor vira Feedback para o Feedback Agent
# propor a melhoria (sempre com aprovacao humana).
AUTO_FEEDBACK_ENABLED=true
AUTO_FEEDBACK_MAX_SCORE=3
# Modelo (opcional, mais barato/rapido) dedicado a avaliacao de grounding; vazio -> usa OPENROUTER_MODEL
OPENROUTER_MODEL_GROUNDING=

# --- Feedback Agent (agente de retaguarda) ---
FEEDBACK_AGENT_INTERVAL_MINUTES=1440
FEEDBACK_AGENT_SCHEDULE_ENABLED=true
FEEDBACK_AGENT_MAX_BATCH_SIZE=100

# --- Observabilidade (OpenTelemetry / Grafana stack) ---
OTEL_ENABLED=true
# No docker-compose o app recebe o endpoint do coletor via `environment`; rodando fora do compose, deixe vazio.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-dev-only

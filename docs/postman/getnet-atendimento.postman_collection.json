{
  "info": {
    "name": "Getnet Atendimento - sessoes, mensagens, fontes web e auditoria",
    "description": "Collection enxuta do atendimento: saude e docs, sessoes e mensagens (incluindo o suporte guiado com abertura de chamado), fontes web homologadas e auditoria. A chave do OpenRouter NAO vem preenchida: informe-a na variavel `llm_api_key` do ambiente (tipo secret, fica so na sua maquina). Importe tambem `getnet-atendimento.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Internal-Service-Token",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{internal_token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
